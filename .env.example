# Ollama (ChatOllama in lib/model.ts)
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=

# Firecrawl (internet_search + firecrawl_fetch_url_tool)
FIRECRAWL_API_KEY=

# LangSmith tracing — https://smith.langchain.com
# Create an API key, then set these. Traces land in LANGSMITH_PROJECT.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atelier
# Required only for org-scoped API keys:
# LANGSMITH_WORKSPACE_ID=
# Recommended on serverless so batches flush before the isolate freezes:
# LANGSMITH_TRACING_BACKGROUND=false
